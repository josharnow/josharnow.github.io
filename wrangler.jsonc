{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "josharnow-personal-site",
  "compatibility_date": "2026-08-21",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./out",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
